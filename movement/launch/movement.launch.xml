<launch>
    <arg name="use_sim_time" default="false" />

    <group>
        <node pkg="movement" exec="straight_line_planner" name="route_planning" output="screen">
            <param name="use_sim_time" value="$(var use_sim_time)"/>
        </node>

        <node pkg="movement" exec="path_executor" name="path_executor" output="screen">
            <param name="use_sim_time" value="$(var use_sim_time)"/>
        </node>
    </group>
</launch>