# Dockerfile for Point-LIO Parameter Optimization
#
# This Dockerfile builds an image for running parameter optimization
# on top of the existing Point-LIO Docker environment.
#
# Usage:
#   docker build -f Dockerfile.optimize -t point_lio_optimizer .
#   docker run -it -v /path/to/data:/data point_lio_optimizer --trials 50

ARG BASE_IMAGE=point_lio:latest
FROM ${BASE_IMAGE}

# Install Python optimization dependencies
RUN apt-get update && apt-get install -y \
    python3-scipy \
    python3-pip \
    python3-tk \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    optuna \
    matplotlib \
    tabulate

# Copy optimization scripts
COPY optimize_utlidar.py /root/point_lio_go2/
COPY analyze_optimization.py /root/point_lio_go2/
COPY compare_trajectories.py /root/point_lio_go2/
COPY entrypoint_optimize.sh /root/point_lio_go2/

RUN chmod +x /root/point_lio_go2/entrypoint_optimize.sh

# Set working directory
WORKDIR /root/point_lio_go2

# Environment variables (can be overridden)
ENV ROSBAG_DIR=/data/rosbag
ENV OUTPUT_DIR=/data/optimization_results
ENV TRIALS=50
ENV TARGET_ATE=0.5

# Entrypoint
ENTRYPOINT ["/root/point_lio_go2/entrypoint_optimize.sh"]

# Default command
CMD ["--analyze"]
